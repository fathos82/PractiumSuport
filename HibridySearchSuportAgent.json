        "cohereApi": {
          "id": "Z0bbJ1usPlSTaQIB",
          "name": "CohereApi account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const chunks = $input.first().json.chunks;\n\nconst documents = chunks.map(c => c.content);\n\nreturn [{ json: { documents } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3504,
        1024
      ],
      "id": "880e3a18-2af8-4502-8007-a94ec1b13f0c",
      "name": "Generate List to Reraking"
    },
    {
      "parameters": {
        "jsCode": "const results = $input.first()?.json?.results ?? [];\nconst chunks = $('Setup chunks').first()?.json?.chunks ?? [];\nconst settings = $('Settings').first()?.json ?? {};\nconst minScore = Number(settings.min_score_to_rank ?? 0.50);\nconst highConfidenceScore = Number(settings.high_confidence_score ?? 0.75);\n\nconst eligible = results\n  .map((result, resultOrder) => {\n    const chunkIndex = Number(result.index);\n    const score = Number(result.relevance_score);\n    const chunk = Number.isInteger(chunkIndex) ? chunks[chunkIndex] : undefined;\n    if (!chunk || !Number.isFinite(score) || score < minScore) return null;\n\n    const sourceMetadata = chunk.metadata ?? {};\n    const metadata = {\n      ...sourceMetadata,\n      doc_id: sourceMetadata.doc_id,\n      file_name: sourceMetadata.file_name,\n      chunk_index: sourceMetadata.chunk_index,\n      chunk_total: sourceMetadata.chunk_total\n    };\n    return {\n      docId: metadata.doc_id,\n      chunkIndex: Number(metadata.chunk_index),\n      resultOrder,\n      document: {\n        content: chunk.content,\n        score,\n        confidence: score >= highConfidenceScore ? 'ALTA' : 'MEDIA',\n        metadata\n      }\n    };\n  })\n  .filter(Boolean);\n\n// Use the best rerank position to retain document relevance priority, then restore\n// chunk order within each document so sequential instructions are not shuffled.\nconst documentOrder = new Map();\nfor (const entry of eligible) {\n  const key = JSON.stringify(entry.docId ?? null);\n  if (!documentOrder.has(key)) documentOrder.set(key, entry.resultOrder);\n}\n\neligible.sort((a, b) => {\n  const aDocOrder = documentOrder.get(JSON.stringify(a.docId ?? null));\n  const bDocOrder = documentOrder.get(JSON.stringify(b.docId ?? null));\n  if (aDocOrder !== bDocOrder) return aDocOrder - bDocOrder;\n\n  const aHasIndex = Number.isFinite(a.chunkIndex);\n  const bHasIndex = Number.isFinite(b.chunkIndex);\n  if (aHasIndex && bHasIndex && a.chunkIndex !== b.chunkIndex) {\n    return a.chunkIndex - b.chunkIndex;\n  }\n  if (aHasIndex !== bHasIndex) return aHasIndex ? -1 : 1;\n  return a.resultOrder - b.resultOrder;\n});\n\nconst sortedDocuments = eligible.map(entry => entry.document);\nreturn [{ json: { hasResults: sortedDocuments.length > 0, sortedDocuments } }];"
      },
