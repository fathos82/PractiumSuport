        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n\"model\": \"rerank-v4.0-fast\",\n\"query\": \"{{ $('Start').first().json.query }}\",\n\"documents\": {{ JSON.stringify($('Generate List to Reraking').item.json.documents) }},\n\"top_n\": 10\n}",
