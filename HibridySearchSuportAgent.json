    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst settings = $('Settings').first().json;\nconst topK = settings.top_k ?? 5;\nconst minScore = settings.min_score_to_expand ?? 0;\nconst hits = items.map(item => item.json);\n\nconst seen = new Set();\nconst toFetch = hits\n  .sort((a, b) => (b.rrf_score ?? 0) - (a.rrf_score ?? 0))\n  .filter(hit => (hit.rrf_score ?? 0) >= minScore)\n  .slice(0, topK)\n  .map(hit => ({\n    doc_id: hit.metadata.doc_id,\n    chunk_index: hit.metadata.chunk_index,\n    rrf_score: hit.rrf_score ?? 0\n  }))\n  .filter(f => {\n    const key = `${f.doc_id}_${f.chunk_index}`;\n    if (seen.has(key)) return false;\n    seen.add(key);\n    return true;\n  });\n\nreturn [{ json: { hits, toFetch } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2704,
        1008
      ],
      "id": "cd2fe3e1-0a9e-494a-89f1-d5bc81e6e3dd",
      "name": "Generate List do Context Expansion"
    },
    {
      "parameters": {
        "jsCode": "const hits = $('Generate List do Context Expansion').first().json.hits ?? [];\nconst expanded = $input.all().map(i => i.json);\nconst all = [...hits, ...expanded];\n\nconst seen = new Set();\nconst uniqueChunks = all.filter(chunk => {\n  const metadata = chunk.metadata ?? {};\n  const hasPosition = metadata.doc_id != null && metadata.chunk_index != null;\n  if (!hasPosition) return true;\n\n  const key = JSON.stringify([metadata.doc_id, metadata.chunk_index]);\n  if (seen.has(key)) return false;\n  seen.add(key);\n  return true;\n});\n\n// Keep document ordering stable while restoring the positional order within each document.\nconst chunks = uniqueChunks\n  .map((chunk, originalIndex) => ({ chunk, originalIndex }))\n  .sort((a, b) => {\n    const aMetadata = a.chunk.metadata ?? {};\n    const bMetadata = b.chunk.metadata ?? {};\n    const aDoc = aMetadata.doc_id == null ? '' : String(aMetadata.doc_id);\n    const bDoc = bMetadata.doc_id == null ? '' : String(bMetadata.doc_id);\n    if (aDoc !== bDoc) return aDoc.localeCompare(bDoc);\n\n    const aIndex = Number(aMetadata.chunk_index);\n    const bIndex = Number(bMetadata.chunk_index);\n    const hasAIndex = Number.isFinite(aIndex);\n    const hasBIndex = Number.isFinite(bIndex);\n    if (hasAIndex && hasBIndex && aIndex !== bIndex) return aIndex - bIndex;\n    if (hasAIndex !== hasBIndex) return hasAIndex ? -1 : 1;\n    return a.originalIndex - b.originalIndex;\n  })\n  .map(entry => entry.chunk);\n\nreturn [{ json: { chunks } }];"
      },
